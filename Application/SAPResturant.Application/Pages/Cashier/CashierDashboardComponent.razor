@page "/CashierDashboard"
@using SAPResturant.Application.DTOs
@inject IHttpClientFactory HttpClientFactory


<AddressingComponent ThisPageUrl="/CashierDashboard" LastPageUrl="@lastpage" TitleName="Add New Order"></AddressingComponent>

<div class="flex-1 flex overflow-hidden px-8 pb-8 space-x-8 container">

    <div class="flex-[3] flex flex-col space-y-8 overflow-y-auto pr-4">
        @if (dashboardData == null)
        {
            <p><em>Loading dashboard...</em></p>
        }
        else
        {
            <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="glass-card p-5 rounded-2xl flex items-center">
                    <div class="p-3 bg-green-100 rounded-xl mr-4"><svg class="w-6 h-6 text-green-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0l.879-.659M7.5 14.25l6-6" /></svg></div>
                    <div><p class="text-sm text-gray-500">Total Sales Today</p><span class="text-2xl font-bold">@dashboardData.TotalSellToday.ToString("C")</span></div>
                </div>
                <div class="glass-card p-5 rounded-2xl flex items-center">
                    <div class="p-3 bg-blue-100 rounded-xl mr-4"><svg class="w-6 h-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 1.085-1.086-1.085m1.086 1.085l1.086 1.085m-1.086-2.171l-1.086 1.085m1.086-1.085l1.086-1.085" /></svg></div>
                    <div><p class="text-sm text-gray-500">Total Tables</p><span class="text-2xl font-bold">@dashboardData.Tables.Count</span></div>
                </div>
                <div class="glass-card p-5 rounded-2xl flex items-center">
                    <div class="p-3 bg-amber-100 rounded-xl mr-4"><svg class="w-6 h-6 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></div>
                    <div><p class="text-sm text-gray-500">Pending Orders</p><span class="text-2xl font-bold">@dashboardData.CountOfOrderToday</span></div>
                </div>
            </section>

            <section class="glass-card p-6 rounded-3xl">
                <h2 class="text-xl font-bold mb-4">Table Status</h2>
                <div class="grid grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-4">
                    @foreach (var table in dashboardData.Tables)
                    {
                        <div class="flex flex-col items-center p-2 rounded-lg @GetTableColorClass(table.Status) cursor-pointer hover:scale-105 transition-transform">
                            <span class="font-bold text-lg">@table.TableName</span>
                            <span class="text-xs">@table.CountOdSeats Seats</span>
                        </div>
                    }
                </div>
                <div class="flex items-center space-x-4 mt-4 text-xs">
                    <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-green-300 mr-2"></span>Available</div>
                    <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-red-300 mr-2"></span>Occupied</div>
                    <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-yellow-300 mr-2"></span>Reserved</div>
                </div>
            </section>
        }
    </div>

    <aside class="flex-1 flex flex-col glass-card p-6 rounded-3xl">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold">Recent Activity</h2>
            <div class="flex items-center space-x-1 bg-gray-200 p-1 rounded-full text-sm">
                <button class="px-3 py-1 rounded-full active-tab" @onclick="() => SetActiveTab(true)">Dine-In</button>
                <button class="px-3 py-1 rounded-full" @onclick="() => SetActiveTab(false)">Takeout</button>
            </div>
        </div>
        <div class="flex-1 overflow-y-auto pr-2">
            @if (dashboardData == null)
            {
                <p><em>Loading activity...</em></p>
            }
            else
            {
                var ordersToShow = showInnerOrders ? dashboardData.InnerOrders : dashboardData.OuterOrders;
                <div class="space-y-4">
                    @foreach (var order in ordersToShow)
                    {
                        <div class="flex items-center justify-between p-3 rounded-lg @(order.OrderStatus == "Unpaid" ? "bg-amber-100/50" : "hover:bg-white/50")">
                            <div>
                                <p class="font-bold">Order #@order.OrderId</p>
                                <p class="text-xs text-gray-500">@order.OrderTableName - @order.OrderStatus</p>
                            </div>
                            <span class="font-semibold @(order.OrderStatus == "Unpaid" ? "text-amber-700" : "text-green-600")">@order.SumPrice.ToString("C")</span>
                        </div>
                    }
                </div>
            }
        </div>
    </aside>
</div>

@code {
    private CashierDashboardDTO? dashboardData;
    private bool showInnerOrders = true; // To toggle between Dine-In and Takeout

    [SupplyParameterFromQuery]
    [Parameter]
    public string? lastpage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("Api");
        try
        {
            // IMPORTANT: Replace this with your actual API endpoint for the dashboard
            dashboardData = await client.GetFromJsonAsync<CashierDashboardDTO>("api/Cashier");
        }
        catch (Exception ex)
        {
            // Log error for debugging
            Console.WriteLine($"Failed to fetch dashboard data: {ex.Message}");
        }
    }

    private void SetActiveTab(bool isInner)
    {
        showInnerOrders = isInner;
    }

    private string GetTableColorClass(string status) => status switch
    {
        "Available" => "bg-green-200 border border-green-300",
        "Occupied" => "bg-red-200 border border-red-300",
        "Reserved" => "bg-yellow-200 border border-yellow-300",
        _ => "bg-gray-200 border border-gray-300"
    };
}