@page "/KitchenDashboard"
@implements IAsyncDisposable
@using SAPResturant.Application.DTOs
@inject IHttpClientFactory HttpClientFactory

<AddressingComponent ThisPageUrl="/KitchenDashboard" LastPageUrl="/" TitleName="Kitchen Display System"></AddressingComponent>

<div class="flex-1 flex flex-col overflow-hidden px-8 pb-8 h-[calc(100vh-100px)]">
    <div class="flex justify-between items-center mb-6 flex-shrink-0">
        <div class="flex space-x-4">
            <div class="glass-card px-6 py-3 rounded-2xl flex items-center space-x-3">
                <span class="w-3 h-3 rounded-full bg-amber-400 animate-pulse"></span>
                <span class="font-bold text-gray-700">Pending: @PendingCount</span>
            </div>
            <div class="glass-card px-6 py-3 rounded-2xl flex items-center space-x-3">
                <span class="w-3 h-3 rounded-full bg-blue-500"></span>
                <span class="font-bold text-gray-700">Cooking: @CookingCount</span>
            </div>
        </div>
        <button @onclick="LoadKitchenOrders" disabled="@isLoading" class="bg-white/70 hover:bg-white p-3 rounded-xl shadow-sm transition-colors" aria-label="Refresh kitchen orders">
            <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        </button>
    </div>

    @if (errorMessage is not null)
    {
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-red-800" role="alert">@errorMessage</div>
    }

    <div class="flex-1 flex space-x-6 overflow-x-auto pb-4">
        <div class="flex-1 min-w-[350px] flex flex-col bg-amber-50/30 rounded-3xl p-4 border border-amber-100">
            <h2 class="text-xl font-bold mb-4 text-amber-800 px-2">New Orders</h2>
            <div class="flex-1 overflow-y-auto space-y-4 pr-2">
                @if (!activeOrders.Any(order => order.Status == "Pending"))
                {
                    <p class="px-2 text-sm text-gray-500">No new kitchen orders.</p>
                }
                @foreach (var order in GetOrdersByStatus("Pending"))
                {
                    <KitchenTicketComponent Order="order"
                                            IsUpdating="@updatingOrderId.HasValue"
                                            OnStartCooking='@(() => ChangeOrderStatus(order.OrderId, "Cooking"))' />
                }
            </div>
        </div>

        <div class="flex-1 min-w-[350px] flex flex-col bg-blue-50/30 rounded-3xl p-4 border border-blue-100">
            <h2 class="text-xl font-bold mb-4 text-blue-800 px-2">Cooking In Progress</h2>
            <div class="flex-1 overflow-y-auto space-y-4 pr-2">
                @if (!activeOrders.Any(order => order.Status == "Cooking"))
                {
                    <p class="px-2 text-sm text-gray-500">No orders are being prepared.</p>
                }
                @foreach (var order in GetOrdersByStatus("Cooking"))
                {
                    <KitchenTicketComponent Order="order"
                                            IsUpdating="@updatingOrderId.HasValue"
                                            OnReady='@(() => ChangeOrderStatus(order.OrderId, "Ready"))' />
                }
            </div>
        </div>

        <div class="flex-1 min-w-[350px] flex flex-col bg-green-50/30 rounded-3xl p-4 border border-green-100">
            <h2 class="text-xl font-bold mb-4 text-green-800 px-2">Ready for Pickup</h2>
            <div class="flex-1 overflow-y-auto space-y-4 pr-2">
                @if (!activeOrders.Any(order => order.Status == "Ready"))
                {
                    <p class="px-2 text-sm text-gray-500">No orders are ready for pickup.</p>
                }
                @foreach (var order in GetOrdersByStatus("Ready"))
                {
                    <KitchenTicketComponent Order="order" IsCompleted="true" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<KitchenDashboardDTO> activeOrders = new();
    private bool isLoading;
    private int? updatingOrderId;
    private string? errorMessage;
    private readonly CancellationTokenSource refreshCancellation = new();
    private Task refreshTask = Task.CompletedTask;

    private int PendingCount => activeOrders.Count(order => order.Status == "Pending");
    private int CookingCount => activeOrders.Count(order => order.Status == "Cooking");

    protected override async Task OnInitializedAsync()
    {
        await LoadKitchenOrders();
        refreshTask = RefreshKitchenOrdersPeriodically(refreshCancellation.Token);
    }

    private async Task RefreshKitchenOrdersPeriodically(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadKitchenOrders();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await refreshCancellation.CancelAsync();
        await refreshTask;
        refreshCancellation.Dispose();
    }

    private async Task LoadKitchenOrders()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var orders = await client.GetFromJsonAsync<List<KitchenDashboardDTO>>("api/kitchen/GetDashboardDTO");
            if (orders is null)
            {
                errorMessage = "The kitchen API returned no order data.";
                return;
            }

            activeOrders = orders;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Could not load kitchen orders: {ex.Message}";
        }
        catch (System.Text.Json.JsonException ex)
        {
            errorMessage = $"The kitchen API returned invalid order data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<KitchenDashboardDTO> GetOrdersByStatus(string status)
    {
        return activeOrders.Where(order => order.Status == status).OrderBy(order => order.OrderTime);
    }

    private async Task ChangeOrderStatus(int orderId, string newStatus)
    {
        if (updatingOrderId.HasValue)
        {
            return;
        }

        updatingOrderId = orderId;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            using var response = await client.PutAsJsonAsync(
                $"api/kitchen/orders/{orderId}/status",
                new { Status = newStatus });

            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrWhiteSpace(details)
                    ? $"Could not update order #{orderId} ({(int)response.StatusCode})."
                    : $"Could not update order #{orderId}: {details}";
                return;
            }

            await LoadKitchenOrders();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Could not update order #{orderId}: {ex.Message}";
        }
        finally
        {
            updatingOrderId = null;
        }
    }
}